# Preserve the original bytes and line endings of research records. This avoids
# changing frozen evidence when it is added to or checked out from Git.
*.md -text whitespace=-blank-at-eol,cr-at-eol
*.py -text whitespace=cr-at-eol
*.json -text whitespace=cr-at-eol
*.yml -text whitespace=cr-at-eol
*.yaml -text whitespace=cr-at-eol
*.txt -text whitespace=cr-at-eol
*.log -text whitespace=cr-at-eol

# Repository governance files themselves use a stable LF representation.
.gitattributes text eol=lf
.gitignore text eol=lf

# Version reproducibility artifacts without inflating ordinary Git objects.
*.parquet filter=lfs diff=lfs merge=lfs -text
*.joblib filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
